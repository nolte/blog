---
import { useTranslations, type UiKey } from "~/i18n/ui";
import type { Locale } from "~/consts";
import { SITE } from "~/consts";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const link = (path: string, l: Locale) => {
  const prefix = l === "en" ? "" : `/${l}`;
  return `${base}${prefix}${path}`;
};

const otherLang: Locale = lang === "en" ? "de" : "en";
const currentPath = Astro.url.pathname
  .replace(new RegExp(`^${base}`), "")
  .replace(/^\/(en|de)(?=\/|$)/, "") || "/";

const nav: { key: UiKey; href: string }[] = [
  { key: "nav.home", href: link("/", lang) },
  { key: "nav.blog", href: link("/blog", lang) },
  { key: "nav.projects", href: link("/projects", lang) },
  { key: "nav.about", href: link("/about", lang) },
];
---

<header class="border-b border-line bg-surface/80 backdrop-blur sticky top-0 z-10">
  <div class="mx-auto flex max-w-3xl items-center justify-between px-4 py-4">
    <a href={link("/", lang)} class="font-mono text-sm font-semibold tracking-tight transition-colors hover:text-link">
      {SITE.title}
    </a>
    <nav class="flex items-center gap-4 text-sm">
      {nav.map((item) => (
        <a href={item.href} class="text-muted transition-colors hover:text-link hover:underline">{t(item.key)}</a>
      ))}
      <a
        href={link(currentPath, otherLang)}
        class="rounded border border-line-strong px-2 py-0.5 text-xs font-mono text-muted transition-colors hover:bg-surface-subtle hover:text-link"
        aria-label={`Switch to ${otherLang.toUpperCase()}`}
      >
        {otherLang.toUpperCase()}
      </a>
      <button
        id="theme-toggle"
        type="button"
        class="theme-toggle inline-flex items-center rounded border border-line-strong p-1.5 text-muted transition-colors hover:bg-surface-subtle hover:text-link"
        aria-label={t("theme.toggle")}
        title={t("theme.toggle")}
      >
        <svg class="icon-sun h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" /><path d="M12 2v2" /><path d="M12 20v2" /><path d="m4.93 4.93 1.41 1.41" /><path d="m17.66 17.66 1.41 1.41" /><path d="M2 12h2" /><path d="M20 12h2" /><path d="m6.34 17.66-1.41 1.41" /><path d="m19.07 4.93-1.41 1.41" />
        </svg>
        <svg class="icon-moon h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
        </svg>
      </button>
    </nav>
  </div>
</header>

<script>
  // Manual theme toggle. The pre-paint bootstrap in BaseLayout already applied
  // any saved choice; this only flips it on click. Flip relative to the
  // *effective* theme (explicit data-theme, else the OS preference) so the
  // first click always does the visible thing.
  const btn = document.getElementById("theme-toggle");
  btn?.addEventListener("click", () => {
    const root = document.documentElement;
    const ds = root.dataset.theme;
    const effective =
      ds === "dark" || ds === "light"
        ? ds
        : window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
    const next = effective === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch (e) {
      /* localStorage unavailable — the in-page toggle still works for this session */
    }
  });
</script>
